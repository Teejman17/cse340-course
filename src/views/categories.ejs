<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <p>Welcome to the categories page. Here you can browse through different categories of content.</p>
    <div class="category-container">
        <ul class="category-list">
            <% categories.forEach(category => { %>
                <li><%= category.name %></></li>
            <% }) %>
        </ul>
    </div>
    
</main>

<%- include('partials/footer') %>