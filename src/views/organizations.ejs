<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Organization Page</h2>
    <p>Here are a few of our partner organizations:</p>
    <ul>
        <% organizations.forEach(organization => { %>
        <li>
            <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo"><strong><%= organization.name %></strong>: <%= organization.contact_email %>
            <a href="/edit-organization/<%= organization.organization_id %>">Edit</a>
        </li>
            
        <% }) %>
    </ul>

    <p><a href="/new-organization">Add a new organization</a></p>
    
</main>

<%- include('partials/footer') %>