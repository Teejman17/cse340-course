<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    <% if (projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <% 
                const formattedDate = project.date
                ? project.date.toLocaleDateString()
                : 'TBD';
                %>
                <li><%= formattedDate %>: <%= project.title %> (<%= project.organization_name %>)</li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No upcoming service projects available.</p>
    <% } %>
</main>
<%- include('partials/footer') %>